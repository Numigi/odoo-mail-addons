<odoo>
    <!-- Modification de la vue form -->
    <record id="email_template_form_with_active" model="ir.ui.view">
        <field name="name">mail.template.form.active</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_form"/>
        <field name="arch" type="xml">
            <field name="email_from" position="before">
                <field name="active" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <!-- Modification de la vue tree pour montrer le statut actif -->
    <record id="email_template_tree_with_active" model="ir.ui.view">
        <field name="name">mail.template.tree.active</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="active" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <!-- Modification de la vue search pour permettre de filtrer par statut actif -->
    <record id="email_template_search_with_active" model="ir.ui.view">
        <field name="name">mail.template.search.active</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.view_email_template_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    
    <!-- Actions de groupe pour archiver/désarchiver plusieurs modèles -->
    <record id="action_mail_template_archive" model="ir.actions.server">
        <field name="name">Archive Templates</field>
        <field name="model_id" ref="mail.model_mail_template"/>
        <field name="binding_model_id" ref="mail.model_mail_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_archive()</field>
    </record>
    
    <record id="action_mail_template_unarchive" model="ir.actions.server">
        <field name="name">Unarchive Templates</field>
        <field name="model_id" ref="mail.model_mail_template"/>
        <field name="binding_model_id" ref="mail.model_mail_template"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_unarchive()</field>
    </record>
</odoo>
